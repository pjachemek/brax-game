{
  "name": "brax-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @brax/web",
    "build": "npm run build --workspace @brax/web",
    "mobile": "npm run start --workspace @brax/mobile",
    "mobile:ios": "npm run ios --workspace @brax/mobile",
    "mobile:android": "npm run android --workspace @brax/mobile",
    "mobile:build": "npm run build:preview --workspace @brax/mobile",
    "engine:dev": "npm run dev --workspace @brax/engine-api",
    "engine:start": "npm run start --workspace @brax/engine-api",
    "engine:bundle": "npm run bundle --workspace @brax/engine-api",
    "engine:image": "docker build -f services/engine-api/Dockerfile -t brax-engine:dev .",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"for (const d of ['apps/web/dist','services/engine-api/dist']) require('fs').rmSync(d, {recursive: true, force: true})\""
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  }
}
