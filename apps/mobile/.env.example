# --- Brax mobile app (apps/mobile) ----------------------------------------
# Read by `expo start` for local development. EAS builds take these from the
# matching profile's `env` block in eas.json instead, so a shipped binary never
# depends on a file that is not in the repo.
#
# This build is HTTP-only: without an engine URL the app cannot open a game.
EXPO_PUBLIC_ENGINE_URL="http://localhost:4000"
EXPO_PUBLIC_ENGINE_TIMEOUT_MS="10000"
